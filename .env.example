# ANVESHAN Environment Configuration
# Copy to .env and populate values locally. NEVER commit .env to GitHub.

# Application settings
ANVESHAN_ENV=development
ANVESHAN_DB_PATH=./data/anveshan.db
ANVESHAN_HOST=0.0.0.0
ANVESHAN_PORT=8000

# Optional AI Provider (Core math, physics, and hypothesis engines work WITHOUT this)
# Official key portal: https://aistudio.google.com/docs/api-key
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Scientific API Polite Pool / Keys (Free keyless access works for arXiv & PubChem)
# OpenAlex polite pool email or API key: https://help.openalex.org/api/authentication/
OPENALEX_EMAIL=
OPENALEX_API_KEY=
